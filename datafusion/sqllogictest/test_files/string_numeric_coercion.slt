##########
## Strict string/numeric coercion policy
## Comparisons require matching types or an explicit CAST/TRY_CAST, even
## for numeric-looking string literals. Numeric widening is still allowed.
## The shared resolution rule also rejects mixed COALESCE, arrays and VALUES.
## CASE results and UNION still unify numbers to text; NVL/IFNULL retain
## their existing text-unification signature. This is not a general ban on
## implicit casts (for example, string/temporal coercion is unchanged).
##########

# Setup test data
statement ok
CREATE TABLE t_int AS VALUES (1), (5), (325), (499), (1000);

statement ok
CREATE TABLE t_float AS VALUES (1.5), (5.0), (325.7), (499.9), (1000.1);

# Reject all comparison operators, including numeric-looking literals.
statement error Error during planning: Cannot infer common argument type for comparison operation Int64 < Utf8
SELECT * FROM t_int WHERE column1 < '5';

statement error Error during planning: Cannot infer common argument type for comparison operation Int64 > Utf8
SELECT * FROM t_int WHERE column1 > '5';

statement error Error during planning: Cannot infer common argument type for comparison operation Int64 <= Utf8
SELECT * FROM t_int WHERE column1 <= '5';

statement error Error during planning: Cannot infer common argument type for comparison operation Int64 >= Utf8
SELECT * FROM t_int WHERE column1 >= '5';

statement error Error during planning: Cannot infer common argument type for comparison operation Int64 = Utf8
SELECT * FROM t_int WHERE column1 = '5';

statement error Error during planning: Cannot infer common argument type for comparison operation Int64 != Utf8
SELECT * FROM t_int WHERE column1 != '5';

statement error Error during planning: Cannot infer common argument type for comparison operation Float64 = Utf8
SELECT * FROM t_float WHERE column1 = '5.0';

statement error Error during planning: Cannot infer common argument type for comparison operation Utf8 = Int64
SELECT * FROM t_int WHERE '5' = column1;

statement error Error during planning: Cannot infer common argument type for comparison operation Int64 = Utf8
SELECT * FROM t_int WHERE column1 = 'abc';

statement error Error during planning: Can not find compatible types to compare
SELECT * FROM t_int WHERE column1 IN ('5', '325');

statement error Error during planning: Can not find compatible types to compare
SELECT * FROM t_int WHERE column1 NOT IN (5, '325');

statement error Error during planning: Failed to coerce types
SELECT * FROM t_int WHERE column1 BETWEEN '5' AND '100';

statement error Error during planning: Failed to coerce case .* and when .* to common types in CASE WHEN expression
SELECT CASE column1 WHEN '5' THEN 'five' ELSE 'other' END FROM t_int;

statement error Error during planning:
SELECT GREATEST(10, '9');

statement error Error during planning:
SELECT LEAST(10, '9');

statement error Error during planning:
SELECT NULLIF(10, '10');

# Shared type resolution is strict too, even when all inputs are literals.
statement error Error during planning:
SELECT COALESCE(1, '2');

statement error Error during planning:
SELECT make_array(1, '2');

statement error Error during planning: Inconsistent data type across values list
VALUES (1), ('2');

statement error Error during planning:
SELECT array_has(['1', 'abc'], 1);

# The motivating stream case must fail while planning, even with zero rows.
statement ok
CREATE TABLE empty_stream (user_id TEXT);

statement error Error during planning: Cannot infer common argument type for comparison operation Utf8View != Int64
SELECT * FROM empty_stream WHERE user_id != 123;

statement ok
DROP TABLE empty_stream;

# Preserve explicit casts, numeric widening and safe result-type unification.
statement ok
CREATE TABLE typed_stream (user_id TEXT, number BIGINT, flag BOOLEAN)
AS VALUES ('123', 123, true), ('abc', 456, false), ('', 0, false);

statement error Error during planning: Cannot infer common argument type for comparison operation Utf8View != Int64
SELECT * FROM typed_stream WHERE user_id != 123;

statement error Error during planning:
SELECT COALESCE(user_id, 123) FROM typed_stream;

statement error Error during planning:
SELECT COALESCE(number, '0') FROM typed_stream;

statement error Error during planning:
SELECT make_array(number, user_id) FROM typed_stream;

query I
SELECT count(*) FROM typed_stream WHERE TRY_CAST(user_id AS BIGINT) = 123;
----
1

query I
SELECT count(*) FROM typed_stream WHERE user_id = CAST(123 AS TEXT);
----
1

query I
SELECT count(*) FROM typed_stream WHERE user_id != '123';
----
2

query I
SELECT count(*) FROM typed_stream WHERE number > CAST(1 AS SMALLINT);
----
2

query TT
SELECT arrow_typeof(NVL(123, '0')), arrow_typeof(IFNULL('abc', 123));
----
Utf8 Utf8

query T
SELECT arrow_typeof(CASE WHEN true THEN 123 ELSE 'abc' END);
----
Utf8

# CASE's common result type must be visible before the analyzer visits users
# of a CTE/subquery column, including captured correlated outer references.
query I
WITH ids AS (SELECT CASE WHEN flag THEN 123 ELSE user_id END AS id FROM typed_stream)
SELECT count(*) FROM ids WHERE id = '123';
----
1

query I
SELECT count(*) FROM typed_stream
WHERE (CASE WHEN flag THEN CASE WHEN flag THEN 123 ELSE user_id END ELSE user_id END) = '123';
----
1

query I
SELECT count(*) FROM typed_stream
WHERE (CASE WHEN flag THEN 123 ELSE user_id END) IN ('123');
----
1

query I
SELECT count(*) FROM typed_stream
WHERE (CASE WHEN flag THEN 123 ELSE user_id END) BETWEEN '123' AND '123';
----
1

query I
SELECT count(*)
FROM (SELECT CASE WHEN flag THEN 123 ELSE user_id END AS id FROM typed_stream) o
WHERE EXISTS (SELECT 1 FROM typed_stream t2 WHERE t2.user_id = o.id);
----
3

statement error Error during planning: Cannot infer common argument type for comparison operation Int64 = Utf8
SELECT *
FROM (SELECT CASE WHEN flag THEN 123 ELSE user_id END AS id FROM typed_stream) o
WHERE EXISTS (SELECT 1 FROM typed_stream t2 WHERE t2.number = o.id);

# INTERSECT/EXCEPT compare their inputs, unlike UNION's text unification.
statement error Error during planning:
SELECT number FROM typed_stream INTERSECT SELECT user_id FROM typed_stream;

statement error Error during planning:
SELECT number FROM typed_stream EXCEPT SELECT user_id FROM typed_stream;

statement ok
DROP TABLE typed_stream;

# -------------------------------------------------
# Explicitly cast literals opt into numeric (not lexicographic) comparison.
# -------------------------------------------------

query I rowsort
SELECT * FROM t_int WHERE column1 < CAST('5' AS BIGINT);
----
1

query I rowsort
SELECT * FROM t_int WHERE column1 > CAST('5' AS BIGINT);
----
1000
325
499

query I rowsort
SELECT * FROM t_int WHERE column1 <= CAST('5' AS BIGINT);
----
1
5

query I rowsort
SELECT * FROM t_int WHERE column1 >= CAST('5' AS BIGINT);
----
1000
325
499
5

query I rowsort
SELECT * FROM t_int WHERE column1 = CAST('5' AS BIGINT);
----
5

query I rowsort
SELECT * FROM t_int WHERE column1 != CAST('5' AS BIGINT);
----
1
1000
325
499

query I rowsort
SELECT * FROM t_int WHERE column1 < CAST('10' AS BIGINT);
----
1
5

query I rowsort
SELECT * FROM t_int WHERE column1 <= CAST('100' AS BIGINT);
----
1
5

query I rowsort
SELECT * FROM t_int WHERE column1 > CAST('100' AS BIGINT);
----
1000
325
499

# -------------------------------------------------
# Float columns with explicitly cast string literals
# -------------------------------------------------

query R rowsort
SELECT * FROM t_float WHERE column1 < CAST('5' AS DOUBLE);
----
1.5

query R rowsort
SELECT * FROM t_float WHERE column1 > CAST('5' AS DOUBLE);
----
1000.1
325.7
499.9

query R rowsort
SELECT * FROM t_float WHERE column1 = CAST('5' AS DOUBLE);
----
5

query R rowsort
SELECT * FROM t_float WHERE column1 = CAST('5.0' AS DOUBLE);
----
5

# -------------------------------------------------
# Explicit CAST still rejects invalid numeric strings and overflow
# -------------------------------------------------

# Non-numeric string against integer column
statement error Arrow error: Cast error: Cannot cast string 'hello' to value of Int64 type
SELECT * FROM t_int WHERE column1 < CAST('hello' AS BIGINT);

# Non-numeric string against float column
statement error Arrow error: Cast error: Cannot cast string 'hello' to value of Float64 type
SELECT * FROM t_float WHERE column1 < CAST('hello' AS DOUBLE);

# Float string against integer column
statement error Arrow error: Cast error: Cannot cast string '99.99' to value of Int64 type
SELECT * FROM t_int WHERE column1 = CAST('99.99' AS BIGINT);

# Empty string against integer column
statement error Arrow error: Cast error: Cannot cast string '' to value of Int64 type
SELECT * FROM t_int WHERE column1 = CAST('' AS BIGINT);

# Empty string against float column
statement error Arrow error: Cast error: Cannot cast string '' to value of Float64 type
SELECT * FROM t_float WHERE column1 = CAST('' AS DOUBLE);

# Overflow
statement error Arrow error: Cast error: Cannot cast string '99999999999999999999' to value of Int64 type
SELECT * FROM t_int WHERE column1 = CAST('99999999999999999999' AS BIGINT);


# -------------------------------------------------
# UNION still uses string coercion (type unification context)
# -------------------------------------------------

statement ok
CREATE TABLE t_str AS VALUES ('one'), ('two'), ('three');

query T rowsort
SELECT column1 FROM t_int UNION ALL SELECT column1 FROM t_str;
----
1
1000
325
499
5
one
three
two

# Verify the UNION coerces to Utf8 (not numeric)
query TT
EXPLAIN SELECT column1 FROM t_int UNION ALL SELECT column1 FROM t_str;
----
logical_plan
01)Union
02)--Projection: CAST(t_int.column1 AS Utf8) AS column1
03)----TableScan: t_int projection=[column1]
04)--TableScan: t_str projection=[column1]
physical_plan
01)UnionExec
02)--ProjectionExec: expr=[CAST(column1@0 AS Utf8) as column1]
03)----DataSourceExec: partitions=1, partition_sizes=[1]
04)--DataSourceExec: partitions=1, partition_sizes=[1]

# -------------------------------------------------
# BETWEEN permits explicit numeric casts
# -------------------------------------------------

query I rowsort
SELECT * FROM t_int WHERE column1 BETWEEN CAST('5' AS BIGINT) AND CAST('100' AS BIGINT);
----
5

# -------------------------------------------------
# IN list permits explicit numeric casts
# `x IN (a, b)` is semantically equivalent to `x = a OR x = b`
# -------------------------------------------------

# Basic IN list with string literals against integer column
query I rowsort
SELECT * FROM t_int WHERE column1 IN (CAST('5' AS BIGINT), CAST('325' AS BIGINT));
----
325
5

# IN list with a value where numeric coercion matters
query I rowsort
SELECT * FROM t_int WHERE column1 IN (CAST('1000' AS BIGINT));
----
1000

# IN list with NOT
query I rowsort
SELECT * FROM t_int WHERE column1 NOT IN (CAST('1' AS BIGINT), CAST('5' AS BIGINT));
----
1000
325
499

# IN list with float column
query R rowsort
SELECT * FROM t_float WHERE column1 IN (CAST('5.0' AS DOUBLE), CAST('325.7' AS DOUBLE));
----
325.7
5

# Verify the plan shows numeric coercion (not CAST to Utf8)
query TT
EXPLAIN SELECT * FROM t_int WHERE column1 IN (CAST('5' AS BIGINT), CAST('325' AS BIGINT));
----
logical_plan
01)Filter: t_int.column1 = Int64(5) OR t_int.column1 = Int64(325)
02)--TableScan: t_int projection=[column1]
physical_plan
01)FilterExec: column1@0 = 5 OR column1@0 = 325
02)--DataSourceExec: partitions=1, partition_sizes=[1]

# Error on invalid string in IN list
statement error Arrow error: Cast error: Cannot cast string 'hello' to value of Int64 type
SELECT * FROM t_int WHERE column1 IN (CAST('5' AS BIGINT), CAST('hello' AS BIGINT));

# Mixed numeric literal and string literal in IN list against integer column
query I rowsort
SELECT * FROM t_int WHERE column1 IN (5, CAST('325' AS BIGINT));
----
325
5

# Mixed numeric literal and string literal in IN list against float column
query R rowsort
SELECT * FROM t_float WHERE column1 IN (5, CAST('325.7' AS DOUBLE));
----
325.7
5

# String and numeric literal order reversed
query R rowsort
SELECT * FROM t_float WHERE column1 IN (CAST('5' AS DOUBLE), 325.7);
----
325.7
5

# Float string literal against integer column errors (cannot cast '10.0' to Int64)
statement error Arrow error: Cast error: Cannot cast string '10.0' to value of Int64 type
SELECT * FROM t_int WHERE column1 IN (5, CAST('10.0' AS BIGINT));

# Non-numeric string in mixed IN list still errors
statement error Arrow error: Cast error: Cannot cast string 'hello' to value of Int64 type
SELECT * FROM t_int WHERE column1 IN (CAST('hello' AS BIGINT), 5);

# -------------------------------------------------
# CASE WHEN comparisons permit explicit casts
# `CASE expr WHEN val` is semantically equivalent to `expr = val`
# -------------------------------------------------

# Basic CASE with integer column and string WHEN values
query T rowsort
SELECT CASE column1 WHEN CAST('5' AS BIGINT) THEN 'five' WHEN CAST('1000' AS BIGINT) THEN 'thousand' ELSE 'other' END FROM t_int;
----
five
other
other
other
thousand

# CASE with float column: explicitly cast '5' to 5.0, matching the row.
# (Under string comparison, '5.0' != '5' would fail to match.)
query T rowsort
SELECT CASE column1 WHEN CAST('5' AS DOUBLE) THEN 'matched' ELSE 'no match' END FROM t_float;
----
matched
no match
no match
no match
no match

# THEN/ELSE results still use type union coercion (string preferred),
# so mixing numeric and string coerces to string
query T rowsort
SELECT CASE WHEN column1 > 500 THEN column1 ELSE 'small' END FROM t_int;
----
1000
small
small
small
small

# -------------------------------------------------
# GREATEST / LEAST permit explicit numeric casts
# -------------------------------------------------

# GREATEST with mixed int and string: numeric comparison, not lexicographic.
query I
SELECT GREATEST(10, CAST('9' AS BIGINT));
----
10

query T
SELECT arrow_typeof(GREATEST(10, CAST('9' AS BIGINT)));
----
Int64

# LEAST with mixed int and string: numeric comparison.
query I
SELECT LEAST(10, CAST('9' AS BIGINT));
----
9

query T
SELECT arrow_typeof(LEAST(10, CAST('9' AS BIGINT)));
----
Int64

# GREATEST with multiple mixed args
query I
SELECT GREATEST(1, CAST('20' AS BIGINT), 3);
----
20

# Non-numeric string in GREATEST errors
statement error Arrow error: Cast error: Cannot cast string 'hello' to value of Int64 type
SELECT GREATEST(1, CAST('hello' AS BIGINT));

# -------------------------------------------------
# NULLIF permits explicit numeric casts
# -------------------------------------------------

# NULLIF with mixed int and string: numeric comparison.
# 10 != 9 numerically, so returns 10.
query I
SELECT NULLIF(10, CAST('9' AS BIGINT));
----
10

query T
SELECT arrow_typeof(NULLIF(10, CAST('9' AS BIGINT)));
----
Int64

# NULLIF with matching values: 10 = 10 numerically, so returns NULL.
query I
SELECT NULLIF(10, CAST('10' AS BIGINT));
----
NULL

# -------------------------------------------------
# Nested struct/map/list comparisons require explicit casts too
# -------------------------------------------------

statement ok
CREATE TABLE t_struct_int AS SELECT named_struct('val', column1) as s FROM (VALUES (1), (5), (10));

statement ok
CREATE TABLE t_struct_str AS SELECT named_struct('val', column1) as s FROM (VALUES ('5'), ('10'));

statement error Error during planning: Cannot infer common argument type for comparison operation
SELECT t1.s FROM t_struct_int t1, t_struct_str t2 WHERE t1.s = t2.s;

# Struct comparison: explicitly cast the string field to Int64.
query ? rowsort
SELECT t1.s FROM t_struct_int t1, t_struct_str t2 WHERE t1.s = arrow_cast(t2.s, 'Struct("val": Int64)');
----
{val: 10}
{val: 5}

# Struct in UNION uses type union coercion (string preferred).
# The integer struct field is cast to Utf8.
query ? rowsort
SELECT s FROM t_struct_int UNION ALL SELECT s FROM t_struct_str;
----
{val: 10}
{val: 10}
{val: 1}
{val: 5}
{val: 5}

statement ok
DROP TABLE t_struct_int;

statement ok
DROP TABLE t_struct_str;

# List comparison: explicitly cast string elements to Int64.
statement ok
CREATE TABLE t_list_int AS SELECT column1 as l FROM (VALUES ([1, 5, 10]), ([20, 30]));

statement ok
CREATE TABLE t_list_str AS SELECT column1 as l FROM (VALUES (['5', '10']), (['20', '30']));

# Verify the element types are Int64 and Utf8 respectively
query T
SELECT arrow_typeof(l) FROM t_list_int LIMIT 1;
----
List(Int64)

query T
SELECT arrow_typeof(l) FROM t_list_str LIMIT 1;
----
List(Utf8)

statement error Error during planning: Cannot infer common argument type for comparison operation
SELECT t1.l FROM t_list_int t1, t_list_str t2 WHERE t1.l = t2.l;

query ? rowsort
SELECT t1.l FROM t_list_int t1, t_list_str t2 WHERE t1.l = CAST(t2.l AS BIGINT[]);
----
[20, 30]

# List comparison casts the string list to the numeric element type (Int64),
# not the other way around.
query TT
EXPLAIN SELECT t1.l FROM t_list_int t1, t_list_str t2 WHERE t1.l = CAST(t2.l AS BIGINT[]);
----
logical_plan
01)Projection: t1.l
02)--Inner Join: t1.l = CAST(t2.l AS List(Int64))
03)----SubqueryAlias: t1
04)------TableScan: t_list_int projection=[l]
05)----SubqueryAlias: t2
06)------TableScan: t_list_str projection=[l]
physical_plan
01)HashJoinExec: mode=CollectLeft, join_type=Inner, on=[(l@0, CAST(t2.l AS List(Int64))@1)], projection=[l@0]
02)--DataSourceExec: partitions=1, partition_sizes=[1]
03)--ProjectionExec: expr=[l@0 as l, CAST(l@0 AS List(Int64)) as CAST(t2.l AS List(Int64))]
04)----DataSourceExec: partitions=1, partition_sizes=[1]

# List in UNION uses type union coercion (string preferred).
# The integer list elements are cast to Utf8.
query ? rowsort
SELECT l FROM t_list_int UNION ALL SELECT l FROM t_list_str;
----
[1, 5, 10]
[20, 30]
[20, 30]
[5, 10]

# Verify the UNION result type has Utf8 elements (not Int64).
query T
SELECT arrow_typeof(l) FROM (SELECT l FROM t_list_int UNION ALL SELECT l FROM t_list_str) LIMIT 1;
----
List(Utf8)

statement ok
DROP TABLE t_list_int;

statement ok
DROP TABLE t_list_str;

# Map comparison: explicitly cast string values to Int64.
statement ok
CREATE TABLE t_map_int AS SELECT MAP {'a': 1, 'b': 5} as m;

statement ok
CREATE TABLE t_map_str AS SELECT MAP {'a': '1', 'b': '5'} as m;

# Verify the value types are Int64 and Utf8 respectively
query T
SELECT arrow_typeof(m) FROM t_map_int LIMIT 1;
----
Map("entries": non-null Struct("key": non-null Utf8, "value": Int64), unsorted)

query T
SELECT arrow_typeof(m) FROM t_map_str LIMIT 1;
----
Map("entries": non-null Struct("key": non-null Utf8, "value": Utf8), unsorted)

statement error Error during planning: Cannot infer common argument type for comparison operation
SELECT t1.m FROM t_map_int t1, t_map_str t2 WHERE t1.m = t2.m;

query ? rowsort
SELECT t1.m FROM t_map_int t1, t_map_str t2 WHERE t1.m = arrow_cast(t2.m, 'Map("entries": non-null Struct("key": non-null Utf8, "value": Int64), unsorted)');
----
{a: 1, b: 5}

# Map in UNION uses type union coercion (string preferred).
# The integer map values are cast to Utf8.
query ? rowsort
SELECT m FROM t_map_int UNION ALL SELECT m FROM t_map_str;
----
{a: 1, b: 5}
{a: 1, b: 5}

# Verify the UNION result type has Utf8 values (not Int64).
query T
SELECT arrow_typeof(m) FROM (SELECT m FROM t_map_int UNION ALL SELECT m FROM t_map_str) LIMIT 1;
----
Map("entries": non-null Struct("key": non-null Utf8, "value": Utf8), unsorted)

statement ok
DROP TABLE t_map_int;

statement ok
DROP TABLE t_map_str;

# -------------------------------------------------
# LIKE / regex on dictionary-encoded numeric columns should error,
# consistent with LIKE on plain numeric columns
# -------------------------------------------------

# Plain integer column: LIKE is not supported
statement error There isn't a common type to coerce Int64 and Utf8 in LIKE expression
SELECT * FROM t_int WHERE column1 LIKE '%5%';

# Dictionary-encoded integer column: should also error
statement error There isn't a common type to coerce Dictionary\(Int32, Int64\) and Utf8 in LIKE expression
SELECT arrow_cast(column1, 'Dictionary(Int32, Int64)') LIKE '%5%' FROM t_int;

# Dictionary-encoded string column: LIKE works as normal
query B rowsort
SELECT arrow_cast('hello', 'Dictionary(Int32, Utf8)') LIKE '%ell%';
----
true

# REE-encoded integer column: LIKE should also error
statement error There isn't a common type to coerce RunEndEncoded.* and Utf8 in LIKE expression
SELECT arrow_cast(column1, 'RunEndEncoded("run_ends": non-null Int32, "values": Int64)') LIKE '%5%' FROM t_int;

# REE-encoded string column: LIKE works as normal
query B rowsort
SELECT arrow_cast('hello', 'RunEndEncoded("run_ends": non-null Int32, "values": Utf8)') LIKE '%ell%';
----
true

# Dictionary-encoded integer column: regex should error
statement error Cannot infer common argument type for regex operation
SELECT arrow_cast(column1, 'Dictionary(Int32, Int64)') ~ '5' FROM t_int;

# Dictionary-encoded string column: regex works as normal
query B rowsort
SELECT arrow_cast('hello', 'Dictionary(Int32, Utf8)') ~ 'ell';
----
true

# REE-encoded integer column: regex should error
statement error Cannot infer common argument type for regex operation
SELECT arrow_cast(column1, 'RunEndEncoded("run_ends": non-null Int32, "values": Int64)') ~ '5' FROM t_int;

# REE-encoded string column: regex works as normal
query B rowsort
SELECT arrow_cast('hello', 'RunEndEncoded("run_ends": non-null Int32, "values": Utf8)') ~ 'ell';
----
true

# -------------------------------------------------
# Cleanup
# -------------------------------------------------

statement ok
DROP TABLE t_int;

statement ok
DROP TABLE t_float;

statement ok
DROP TABLE t_str;

# -------------------------------------------------
# List element coercion should reject mixed
# numeric/string categories (same as array literals)
# -------------------------------------------------

# Array literal with mixed numeric/string elements errors
query error Error during planning:
SELECT [1, 'a'];

# MAP with mixed-category list keys should also error
query error Error during planning:
SELECT MAP {[1,2,3]:1, ['a', 'b']:2};

# MAP with mixed-category list values should also error
query error Error during planning:
SELECT MAP {'a':[1,2,3], 'b':['a', 'b']};
